PORT=8787
API_BIND_HOST=127.0.0.1
DB_BIND_HOST=127.0.0.1
# Nginx on the host reaches Docker through a private bridge address.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash
MODEL_OPTIONS=deepseek-v4-flash,deepseek-v4-pro
PROMPT_VERSION=2026-08-03-comparison-evidence-v2

# AI usage ledger. Streaming providers that do not support final usage are
# retried without stream_options and recorded as tokenizer-free estimates.
AI_USAGE_TRACKING_ENABLED=1
CHAT_STREAM_INCLUDE_USAGE=1
# DeepSeek V4 defaults to high-effort thinking. Keep website responses fast by
# default; set to 1 only after the reverse proxy is configured for long SSE.
DEEPSEEK_THINKING_ENABLED=0
# Optional one-line JSON. Prices are ordinary currency units per 1M tokens;
# events keep the selected version so historical cost does not change later.
# AI_MODEL_PRICES_JSON=[{"provider":"deepseek","model":"your-chat-model","operation_kind":"chat","version":"2026-08","currency":"CNY","input_per_million":0,"cached_input_per_million":0,"output_per_million":0,"effective_from":"2026-08-01T00:00:00Z"},{"provider":"zhipu","model":"embedding-3","operation_kind":"embedding","version":"2026-08","currency":"CNY","input_per_million":0,"output_per_million":0,"effective_from":"2026-08-01T00:00:00Z"}]
AI_MODEL_PRICES_JSON=

# Zhipu embeddings (separate from DeepSeek chat)
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=v1
RETRIEVE_REQUIRE_CURRENT_EMBEDDING=1
RAG_PROMPT_MAX_CHARS=32000
RAG_CONTEXT_MAX_CHARS=20000
RAG_INVENTORY_MAX_CHARS=5000
RAG_CARDS_MAX_CHARS=5000
RAG_HISTORY_MAX_CHARS=8000
RAG_TOOL_EVIDENCE_MAX_CHARS=12000

# Hierarchical conversation memory
CONVERSATION_MEMORY_ENABLED=1
MEMORY_QUERY_REWRITE_ENABLED=1
MEMORY_SEMANTIC_RECALL_ENABLED=1
MEMORY_BACKGROUND_COMPACTION_ENABLED=1
# Optional cheaper chat model for query rewrite / rolling summaries.
MEMORY_MODEL=
MEMORY_SUMMARY_TRIGGER_MESSAGES=20
MEMORY_SUMMARY_BATCH_MESSAGES=8
MEMORY_SUMMARY_MAX_CHARS=6000
MEMORY_EPISODE_MAX_CHARS=4000
MEMORY_REWRITE_HISTORY_MAX_CHARS=6000
MEMORY_RECALL_TOP_K=4
MEMORY_RECALL_CANDIDATE_CAP=100
MEMORY_RECALL_MAX_CHARS=4000
MEMORY_RECALL_MIN_SCORE=0.18
BM25_ENABLED=1
POSTGRES_TRIGRAM_ENABLED=1
POSTGRES_TRIGRAM_CANDIDATE_CAP=500
VECTOR_BACKEND=pgvector
INDEX_JOB_ENABLED=1

# Security (P0) — never commit this file
JWT_SECRET=
JWT_REQUIRE_STRONG=1
AUTH_EXPOSE_CODE=0
AUTH_ALLOW_PHONE_REGISTER=0

# Email verification (required when AUTH_EXPOSE_CODE=0)
# 填好后把下面三项改成你的邮箱；PASSWORD 必须是「授权码」不是登录密码
# —— QQ 邮箱：smtp.qq.com:587，在 QQ 邮箱设置 → 账户 → 开启 SMTP → 生成授权码
# —— 163：smtp.163.com:587
# —— 学校企业邮：问网管要 SMTP 主机/端口
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Indexing recovery
INDEX_MAX_ATTEMPTS=3
INDEX_STALE_MINUTES=30
INDEX_RECOVER_ON_STARTUP=1
INDEX_EXTERNAL_WORKER=1
INDEX_WORKER_POLL_SECONDS=2
INDEX_WORKER_RECOVERY_SECONDS=60
INDEX_WORKER_HEARTBEAT_SECONDS=15
INDEX_WORKER_STALE_SECONDS=45
INDEX_WORKER_LEASE_SECONDS=90

# Vision (智谱多模态；复用 EMBEDDING_API_KEY)
VISION_ENABLED=1
VISION_MODEL=glm-4.6v-flash
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=  # 不填则用 EMBEDDING_API_KEY

# Postgres + pgvector (Docker: docker compose up -d db)
DATABASE_URL=postgresql+psycopg2://paperpilot:paperpilot@localhost:5432/paperpilot
POSTGRES_PASSWORD=paperpilot

# Public-beta defaults (local can keep CORS *)
CORS_ORIGINS=https://www.paperpilot.xin
QUOTA_DAILY_QUERIES=80
QUOTA_DAILY_UPLOADS=20
RATE_LIMIT_SEND_CODE_IP_MAX=10
AUTH_CODE_DAILY_MAX_PER_TARGET=8

# Speed knobs
EMBED_CONCURRENCY=3
CONTEXTUAL_PREFIX_CONCURRENCY=8
RESPONSE_CACHE_TTL_MS=600000
COMPARE_MAX_DOCUMENTS=12
COMPARE_CHUNKS_PER_DOCUMENT=4
INVENTORY_PROMPT_MAX_DOCUMENTS=50
