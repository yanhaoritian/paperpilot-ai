# =============================================================================
# PaperPilot Lab — copy to .env and fill secrets. Never commit .env.
# =============================================================================

# --- Lab / Compose: Postgres + pgvector
DATABASE_URL=postgresql+psycopg2://paperpilot:paperpilot@localhost:5432/paperpilot
POSTGRES_PASSWORD=paperpilot
# 仅本机无 Docker 时可不设 DATABASE_URL，默认 SQLite: data/paperpilot.db

# REQUIRED in lab/prod: random string >= 24 chars (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret-at-least-24
JWT_REQUIRE_STRONG=1
JWT_EXPIRE_DAYS=7

HOST=0.0.0.0
PORT=8787

OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=your-base-url
DEFAULT_MODEL=gpt-4.1-mini

# 向量可与聊天拆开（例如 DeepSeek 聊天 + 智谱 embedding）
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_KEY=your-zhipu-key
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Embedding governance — bump EMBEDDING_VERSION then re-index to migrate
EMBEDDING_VERSION=v1
RETRIEVE_REQUIRE_CURRENT_EMBEDDING=1
# 中转站若 /embeddings 经常 503，可改用本地哈希向量（聊天仍走中转）：
# EMBEDDING_PROVIDER=local
# RAG_MIN_SIMILARITY=0.05
# EMBEDDING_RETRIES=3

# PDF_STORAGE_DIR=./data/pdfs
PDF_MAX_UPLOAD_MB=32

# RAG
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.22
CHUNK_TARGET_CHARS=2000
CHUNK_MIN_CHARS=450
CHUNK_OVERLAP_RATIO=0.15
MAX_CHUNKS=280
EMBED_BATCH_SIZE=64

# Rate limits (per IP)
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_UPLOAD_MAX=25
RATE_LIMIT_QUERY_MAX=60
# 注册发码：每 IP 每小时
RATE_LIMIT_SEND_CODE_IP_MAX=10
RATE_LIMIT_SEND_CODE_IP_WINDOW_SECONDS=3600
# 同一邮箱每日发码上限
AUTH_CODE_DAILY_MAX_PER_TARGET=8

# 每用户每日配额（0=不限制）
QUOTA_DAILY_QUERIES=80
QUOTA_DAILY_UPLOADS=20

# 公网请改为你的站点域名，逗号分隔；本地可先用 *
# CORS_ORIGINS=https://your.domain.com
CORS_ORIGINS=*

# Auth — lab/prod: keep AUTH_EXPOSE_CODE=0 and configure SMTP for real email codes
AUTH_EXPOSE_CODE=0
AUTH_ALLOW_PHONE_REGISTER=0
# AUTH_CODE_TTL_SECONDS=300
# AUTH_CODE_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your@qq.com
SMTP_USE_TLS=1

# Vision — 推荐智谱 glm-4v-flash（与 embedding 同账号）
VISION_ENABLED=1
VISION_MODEL=glm-4v-flash
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=  # 默认复用 EMBEDDING_API_KEY

# Indexing recovery
INDEX_MAX_ATTEMPTS=3
INDEX_STALE_MINUTES=30
INDEX_RECOVER_ON_STARTUP=1

# OCR for scanned PDFs (RapidOCR via pip; no system Tesseract)
OCR_ENABLED=1
OCR_MIN_CHARS_PER_PAGE=40
OCR_MAX_PAGES=80

# Chat history turns fed into streaming prompt
CHAT_HISTORY_TURNS=6

# Four-layer PDF stack
VISION_ENABLED=0
CONTEXTUAL_CHUNK_ENABLED=1
HYBRID_RECALL_ENABLED=1
BM25_ENABLED=1
BM25_CANDIDATE_CAP=8000
VECTOR_BACKEND=pgvector
INDEX_JOB_ENABLED=1
RERANK_PROVIDER=llm
AGENT_ENABLED=1
AGENT_MAX_TOOL_ROUNDS=4
INDEX_USE_THREAD_POOL=1

# Optional Postgres password for Compose
# POSTGRES_PASSWORD=paperpilot
