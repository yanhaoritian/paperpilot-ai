PORT=8787
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash
MODEL_OPTIONS=deepseek-v4-flash,deepseek-v4-pro

# Zhipu embeddings (separate from DeepSeek chat)
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=v1
RETRIEVE_REQUIRE_CURRENT_EMBEDDING=1
BM25_ENABLED=1
VECTOR_BACKEND=pgvector
INDEX_JOB_ENABLED=1

# Security (P0) — never commit this file
JWT_SECRET=
JWT_REQUIRE_STRONG=1
AUTH_EXPOSE_CODE=0
AUTH_ALLOW_PHONE_REGISTER=0

# Email verification (required when AUTH_EXPOSE_CODE=0)
# 填好后把下面三项改成你的邮箱；PASSWORD 必须是「授权码」不是登录密码
# —— QQ 邮箱：smtp.qq.com:587，在 QQ 邮箱设置 → 账户 → 开启 SMTP → 生成授权码
# —— 163：smtp.163.com:587
# —— 学校企业邮：问网管要 SMTP 主机/端口
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Indexing recovery
INDEX_MAX_ATTEMPTS=3
INDEX_STALE_MINUTES=30
INDEX_RECOVER_ON_STARTUP=1

# Vision (智谱多模态；复用 EMBEDDING_API_KEY)
VISION_ENABLED=1
VISION_MODEL=glm-4.6v-flash
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=  # 不填则用 EMBEDDING_API_KEY

# Postgres + pgvector (Docker: docker compose up -d db)
DATABASE_URL=postgresql+psycopg2://paperpilot:paperpilot@localhost:5432/paperpilot
POSTGRES_PASSWORD=paperpilot

# Public-beta defaults (local can keep CORS *)
CORS_ORIGINS=https://www.paperpilot.xin
QUOTA_DAILY_QUERIES=80
QUOTA_DAILY_UPLOADS=20
RATE_LIMIT_SEND_CODE_IP_MAX=10
AUTH_CODE_DAILY_MAX_PER_TARGET=8

# Speed knobs
EMBED_CONCURRENCY=3
CONTEXTUAL_PREFIX_CONCURRENCY=8
RESPONSE_CACHE_TTL_MS=600000
